# Required: your NVIDIA API key from https://build.nvidia.com (starts with nvapi-)
NVIDIA_API_KEY=nvapi-...

# Optional: preferred default model. If unset or retired, the app lists the models
# available to your key and picks one; you can switch in the UI dropdown.
# NVIDIA_MODEL=

# Optional: override for a self-hosted NIM, e.g. http://localhost:8000/v1
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

PORT=3000
MAX_ROWS=200
